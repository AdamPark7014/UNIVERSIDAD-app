# =============================================================================
# UNIVERSIDAD-app — plantilla de entorno
# Copia a `.env` y llena los valores reales. Nunca subas `.env` al repo.
# =============================================================================

# --- Base de datos ---
# La cadena de conexion vive en apps/api/.env, que es donde la busca el CLI de
# Prisma. Por omision es SQLite: un archivo en apps/api/prisma/universidad.db.

# --- API Nest ---
NODE_ENV=development
PORT=4180
# Origen del front para CORS
WEB_ORIGIN=http://localhost:3180

# --- Raíz de los documentos del semestre ---
# Es la carpeta que contiene 01-Interaccion-Humano-Computadora-CN220, 02-..., etc.
# El importador lee y escribe los .docx aquí. Debe existir.
DOCS_ROOT=C:\Users\adpoz\OneDrive\Documentos\Universidad\2026-Semestre-5

# Semestre activo (debe coincidir con el `codigo` en la tabla Semestre)
SEMESTRE_ACTIVO=2026-OTO

# Si es true, al escribir un .docx se guarda una copia previa en .bak
BACKUP_ON_WRITE=true

# Reimporta solo cuando Word guarda un .docx en DOCS_ROOT.
# Ponlo en false si trabajas sin la API arriba o si OneDrive genera mucho ruido.
VIGILAR_DISCO=true

# Palabras minimas para dar por hechas las notas de una clase.
# Por debajo, la app avisa. 50 es aprox. media cuartilla de apuntes reales.
UMBRAL_NOTAS=50

# --- Front Next.js ---
# URL base del API desde el navegador
NEXT_PUBLIC_API_URL=http://localhost:4180
